{
    "manifest_version": 3,
    "name": "Minimal YouTube",
    "version": "0.9.8",
    "minimum_chrome_version": "114",
    "description": "A focused YouTube experience: clean search, centered channels, video pages and playlists, without recommendations or Shorts.",
    "author": "Ephraim Atta-Duncan",
    "icons": {
        "16": "assets/16x16.png",
        "48": "assets/48x48.png",
        "128": "assets/128x128.png"
    },
    "content_scripts": [
        {
            "js": ["src/content/search-data.js", "src/content/channel-main.js", "src/content/channel-navigation-main.js"],
            "world": "MAIN",
            "run_at": "document_start",
            "matches": ["https://*.youtube.com/*"],
            "exclude_matches": ["https://music.youtube.com/*"]
        },
        {
            "css": [
                "src/styles/styles.css"
            ],
            "js": [
                "src/content/channel-boot.js",
                "src/content/ads.js",
                "src/content/watch.js",
                "src/content/playlist.js",
                "src/content/search-data.js",
                "src/content/search.js",
                "src/content/channel.js",
                "src/content/content.js"
            ],
            "run_at": "document_start",
            "matches": [
                "https://*.youtube.com/*"
            ],
            "exclude_matches": [
                "https://music.youtube.com/*"
            ]
        }
    ],
    "action": {
        "default_popup": "src/popup/popup.html"
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "host_permissions": [
        "https://*.youtube.com/*",
        "https://*.doubleclick.net/*",
        "https://*.googleadservices.com/*",
        "https://*.googlesyndication.com/*"
    ],
    "permissions": [
        "storage",
        "cookies",
        "declarativeNetRequestWithHostAccess",
        "scripting"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/home/index.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        },
        {
            "resources": [
                "src/assets/fonts/*.ttf"
            ],
            "matches": [
                "https://*.youtube.com/*"
            ]
        }
    ]
}
