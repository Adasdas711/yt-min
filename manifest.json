{
    "manifest_version": 3,

    "name": "Minimal YouTube",
    "version": "1.8.1",
    "minimum_chrome_version": "114",
    "description": "A focused YouTube experience: clean search, centered channels and video pages, without recommendations or Shorts.",
    "author": "Ephraim Atta-Duncan",

    "icons": {
        "16": "assets/16x16.png",
        "48": "assets/48x48.png",
        "128": "assets/128x128.png"
    },

    "content_scripts": [
        {
            "css": ["src/styles/styles.css"],
            "js": ["src/content/watch.js", "src/content/content.js"],
            "run_at": "document_start",
            "matches": ["https://*.youtube.com/*"],
            "exclude_matches": ["https://music.youtube.com/*"]
        }
    ],

    "action": {
        "default_popup": "src/popup/popup.html"
    },

    "background": {
        "service_worker": "src/background.js"
    },

    "host_permissions": ["https://*.youtube.com/*"],
    "permissions": ["storage", "cookies"]
}
